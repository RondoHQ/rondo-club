      "css": ".ds-scopes{display:flex;flex-wrap:wrap;gap:1.25rem;border-bottom:1px solid var(--color-gray-200,oklch(92.8% .006 264.531))}.ds-scope{font-family:var(--font-sans,ui-sans-serif,system-ui,sans-serif);font-size:.875rem;line-height:1.25rem;padding:0 0 .75rem;background:transparent;border:0;border-bottom:2px solid transparent;color:var(--color-gray-500,oklch(55.1% .027 264.364));cursor:pointer}.ds-scope[aria-pressed=true]{border-bottom-color:var(--color-electric-cyan,oklch(.69 .14 196));color:var(--color-cyan-800,oklch(45% .085 224.283));font-weight:500}.ds-scope:focus-visible{outline:auto}"
