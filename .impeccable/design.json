      "refersTo": "dashboard-action",
      "description": "Outlined header control with corrected light-theme text.",
      "html": "<button class=\"ds-action\">Verversen</button>",
      "css": ".ds-action{font-family:var(--font-sans,ui-sans-serif,system-ui,sans-serif);font-size:.875rem;line-height:1.25rem;padding:.5rem 1rem;border:1px solid var(--color-electric-cyan,oklch(.69 .14 196));border-radius:.5rem;color:var(--color-cyan-800,oklch(45% .085 224.283));background:transparent;font-weight:500;cursor:pointer;transition:all 200ms ease-in-out}.ds-action:hover{background:color-mix(in oklch,var(--color-electric-cyan,oklch(.69 .14 196)) 10%,transparent);transform:translateY(-2px)}.ds-action:focus-visible{outline:2px solid var(--color-electric-cyan,oklch(.69 .14 196));outline-offset:2px}"
    },
    {
      "name": "Primary save action",
      "kind": "button",
      "description": "Incumbent primary button used by the layout editor.",
      "html": "<button class=\"ds-save\">Indeling opslaan</button>",
      "css": ".ds-save{font-family:var(--font-sans,ui-sans-serif,system-ui,sans-serif);font-size:.875rem;line-height:1.25rem;padding:.5rem 1rem;border:0;border-radius:.5rem;background:linear-gradient(135deg,var(--color-electric-cyan,oklch(.69 .14 196)),var(--color-bright-cobalt,oklch(.55 .19 264)));color:white;font-weight:500;cursor:pointer;transition:all 200ms ease-in-out}.ds-save:hover{transform:translateY(-2px);box-shadow:0 10px 15px -3px rgb(6 182 212 / .5)}.ds-save:focus-visible{outline:2px solid var(--color-electric-cyan,oklch(.69 .14 196));outline-offset:2px}.ds-save:disabled{opacity:.5;cursor:not-allowed}"
    },
