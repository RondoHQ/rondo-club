# Rondo Club theme — legacy service worker headers.
#
# The application registers the WordPress-served /sw.js endpoint, which gets
# root scope without depending on web-server configuration. Keep these headers
# as defense in depth for clients that still request the previous dist/sw.js
# URL while updating from an older release.
<IfModule mod_headers.c>
	<Files "sw.js">
		Header set Service-Worker-Allowed "/"
		Header set Cache-Control "no-cache, max-age=0"
	</Files>
</IfModule>
